Output docs/walkthroughs/troubleshooting.gif
Set Shell "bash"
Set FontSize 18
Set Width 1200
Set Height 720
Set TypingSpeed 60ms

Type "echo 'Auth failure? Verify remote URL + credentials'"
Enter
Sleep 1s
Type "echo 'Merge conflict? Open Merge view and resolve per file'"
Enter
Sleep 1s
Type "echo 'Detached HEAD? Switch/create branch in Branch Manager'"
Enter
Sleep 1s
Type "echo 'Lock file? Ensure no active git process, then clear stale lock'"
Enter
Sleep 1s
